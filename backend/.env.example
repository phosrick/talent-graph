# =============================================================================
# TalentGraph (思拓) - 环境变量配置模版
# 复制此文件为 .env 并按需填写配置: cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 核心 LLM 配置 (默认推荐 DeepSeek)
# -----------------------------------------------------------------------------
# LLM 提供商: "deepseek" (推荐) | "openai" | "dashscope"
LLM_PROVIDER=deepseek

# DeepSeek 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 推荐使用 flash/chat 模型关闭推理思考过程以获得极致响应速度
DEEPSEEK_MODEL=deepseek-chat
# 最大并发请求数 (限流信号量，防止触发服务商 429 报错)
LLM_MAX_CONCURRENCY=20
# LLM 请求超时时间 (秒)
LLM_TIMEOUT=60
# 失败重试次数
LLM_MAX_RETRIES=3

# OpenAI 备用配置 (可选)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# 阿里云 DashScope / 通义千问 备用配置 (可选)
DASHSCOPE_API_KEY=
QWEN_MODEL_NAME=qwen-plus

# -----------------------------------------------------------------------------
# 2. 向量计算配置 (纯 CPU 本地或云端 API)
# -----------------------------------------------------------------------------
# 向量提供者: "onnx" (纯 CPU 本地 ONNX 推理, 极速轻量) | "api" (DeepSeek/OpenAI API)
EMBEDDING_PROVIDER=onnx
# ONNX 向量模型名称或本地路径
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 向量计算批处理大小
EMBEDDING_BATCH_SIZE=32

# -----------------------------------------------------------------------------
# 3. 算法与流水线配置
# -----------------------------------------------------------------------------
# 节点语义相似度命中阈值 (0.0 ~ 1.0)
NODE_SIMILARITY_THRESHOLD=0.85
# 题库标准图谱缓存目录
CORPUS_CACHE_DIR=./data/cache/corpus
# 评测输出根目录
OUTPUT_DIR=./data/output

# -----------------------------------------------------------------------------
# 4. 服务与 API 配置
# -----------------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# 跨域允许源 (逗号分隔，或 * 表示全部)
CORS_ORIGINS=*

# -----------------------------------------------------------------------------
# 5. Playwright 内置无头浏览器 PDF 导出配置
# -----------------------------------------------------------------------------
# 是否启用 PDF 导出
PDF_EXPORT_ENABLED=true
# PDF 渲染超时时间 (毫秒)
PDF_TIMEOUT_MS=30000
# 页面渲染等待选择器
PDF_WAIT_UNTIL=networkidle

# -----------------------------------------------------------------------------
# 6. Mock 与独立运行配置 (保持纯粹无外部依赖)
# -----------------------------------------------------------------------------
# 模拟邮件发送 (仅打印 Log，不发送真实邮件)
MOCK_EMAIL=true
# 关闭任何外部企业数据上报
ENABLE_TELEMETRY=false
